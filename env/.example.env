ASPNETCORE_ENVIRONMENT=Development

# SQL Server - authentication data (Roles, ApiKeys, ApiKeyRoles) and the stg.* staging tables
ConnectionStrings__AuthDb=Server=localhost,1433;Database=AuthDb;User Id=sa;Password=changeme;TrustServerCertificate=True;

# PostgreSQL - business data (Products)
ConnectionStrings__AppDb=Host=localhost;Port=5432;Database=AppDb;Username=postgres;Password=changeme

# API key format prefix, e.g. "kbat_<keyId>.<secret>"
ApiKey__Prefix=kbat

# ---------------------------------------------------------------------------
# Automation project (KeyBasedAuthenticationTemplate_Automation)
# ---------------------------------------------------------------------------
# Only the secret lives here. Everything else (API URL, timeouts, endpoints, report output folder,
# recipients, log file path/retention, report definitions) is in the Automation project's
# appsettings.json; any of it can be overridden here with the Automation__* / Serilog__* form, e.g.
#   Automation__Api__BaseUrl=https://api.example.com
#   Automation__Reports__OutputDirectory=D:/reports
#   Automation__Reports__Recipients__0=reports@example.com
#   Serilog__WriteTo__1__Args__path=D:/logs/automation-.log

# API key the automation authenticates with. It needs the Reporter role (report endpoints) and
# the Writer role (sending the mock email and loading staging are POSTs). The value below is the
# dev automation key seeded by DbInitializer in Development; outside Development, create one with an
# Admin key via POST /api/apikeys with "roles": ["Reporter", "Writer"] (shown only once).
Automation__Api__Key=kbat_devautomation.dev-automation-secret-change-me
