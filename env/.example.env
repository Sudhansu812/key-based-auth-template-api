ASPNETCORE_ENVIRONMENT=Development

# SQL Server - authentication data (Users, ApiKeys)
ConnectionStrings__AuthDb=Server=localhost,1433;Database=AuthDb;User Id=sa;Password=changeme;TrustServerCertificate=True;

# PostgreSQL - business data (Products)
ConnectionStrings__AppDb=Host=localhost;Port=5432;Database=AppDb;Username=postgres;Password=changeme

# JWT signing (HMAC-SHA256). Generate a long random secret, e.g.: openssl rand -base64 48
Jwt__Secret=replace-with-a-long-random-secret-at-least-32-characters
Jwt__Issuer=KeyBasedAuthenticationTemplate
Jwt__Audience=KeyBasedAuthenticationTemplate.Client
Jwt__ExpiryMinutes=60

# API key format prefix, e.g. "kbat_<keyId>.<secret>"
ApiKey__Prefix=kbat

# ---------------------------------------------------------------------------
# Automation project (KeyBasedAuthenticationTemplate_Automation)
# ---------------------------------------------------------------------------
# Base URL of the running API.
Automation__ApiBaseUrl=http://localhost:5090

# API key the automation authenticates with. Create one as an Admin via POST /api/apikeys
# with "accessLevel": "ReadWrite" (ReadWrite is required because sending the mock email is a
# POST). The full key is shown only once - paste it here, and keep it out of source control.
Automation__ApiKey=kbat_replace-with-a-real-api-key

# HTTP timeout for each API call, in seconds.
Automation__ApiTimeoutSeconds=60

# Where generated .xlsx files and the JSON log files are written (relative paths resolve
# against the working directory).
Automation__ReportOutputDirectory=reports-output
Automation__LogDirectory=logs

# Mock-email recipients (arrays use indexed keys).
Automation__ReportRecipients__0=reports@example.com
Automation__ErrorNotificationRecipients__0=ops-alerts@example.com
