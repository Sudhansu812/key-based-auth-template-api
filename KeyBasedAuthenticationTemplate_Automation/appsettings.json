{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    },
    "Enrich": [ "FromLogContext" ],
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/automation-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "formatter": {
            "type": "Serilog.Formatting.Json.JsonFormatter, Serilog",
            "renderMessage": true
          }
        }
      }
    ]
  },
  "Automation": {
    "Api": {
      "BaseUrl": "http://localhost:5090",
      "Key": "",
      "TimeoutSeconds": 60,
      "ErrorDetailMaxLength": 300,
      "Endpoints": {
        "Email": "api/notifications/email",
        "ProductRiskStaging": "api/staging/product-risk-summary"
      }
    },
    "Reports": {
      "OutputDirectory": "reports-output",
      "FileTimestampFormat": "yyyyMMdd_HHmmss",
      "Recipients": [ "reports@example.com" ],
      "EmailSubject": "Automated reports - {0:yyyy-MM-dd}",
      "Definitions": {
        "products-ef": {
          "Enabled": true,
          "Endpoint": "api/products",
          "SheetName": "Products (EF)"
        },
        "users-ef": {
          "Enabled": true,
          "Endpoint": "api/reports/ef/users",
          "SheetName": "Users (EF)"
        },
        "products-dapper": {
          "Enabled": true,
          "Endpoint": "api/reports/dapper/products",
          "SheetName": "Products (Dapper)"
        },
        "users-dapper": {
          "Enabled": true,
          "Endpoint": "api/reports/dapper/users",
          "SheetName": "Users (Dapper)"
        }
      }
    },
    "ErrorNotification": {
      "Recipients": [ "ops-alerts@example.com" ],
      "Subject": "[ALERT] Report automation failed - {0} error(s)"
    }
  }
}
